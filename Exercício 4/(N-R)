clc; clear;
exec('C:\Users\dziob\OneDrive\Área de Trabalho\Calculo Numerico\Programas\newtonRaphson.sci');

// Dados
A = 1000;
n = 24;
q = 5;

// Valor da parcela
P = A*(1/n + q/100);

// Definição das funções inserindo os valores numéricos diretamente nelas para evitar o erro da deff local
deff('y=f(x)', 'y = ( ' + string(A) + '*x - ' + string(P) + ' ) * (1+x)^' + string(n) + ' + ' + string(P));
deff('y=df(x)', 'y = ' + string(A) + '*(1+x)^' + string(n) + ' + (' + string(A) + '*x - ' + string(P) + ')*' + string(n) + '*(1+x)^(' + string(n-1) + ')');

// Dados iniciais
x0 = 0.05;
tol = 1e-5; // Uma tolerância menor para melhorar a precisão
maxIter = 100;

// Executa o método
[x, iter] = newtonRaphson(f, df, x0, tol, maxIter);

// Resultados
printf("\n--- RESULTADOS --- \n");
printf("Iterações: %d\n", iter);
printf("Taxa mensal: %.4f%%\n", x * 100);
printf("Taxa anual: %.4f%%\n", x * 12 * 100);
